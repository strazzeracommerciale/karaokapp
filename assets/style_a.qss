/* KaraokeManager — tema A: chiaro ad alto contrasto (celeste → blu) */

* {
    font-family: ".AppleSystemUIFont", "Helvetica Neue", sans-serif;
    color: #152238;
}

QMainWindow, QWidget {
    background-color: #e8f1fa;
}

QLineEdit, QListWidget, QComboBox {
    background-color: #ffffff;
    border: 1px solid #b8d4ea;
    border-radius: 6px;
    padding: 6px 10px;
    color: #152238;
    selection-background-color: #4a9fd4;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #4a9fd4;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #b8d4ea;
    selection-background-color: #6ec5e8;
    selection-color: #152238;
}

QPushButton {
    background-color: #4a9fd4;
    border: 1px solid #3d8cc4;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    color: #ffffff;
}

QPushButton:hover {
    background-color: #5bb3e8;
    border-color: #4a9fd4;
}

QPushButton:pressed {
    background-color: #2d6fa8;
    border-color: #3d8cc4;
}

QPushButton#secondaryButton {
    background-color: #5b7fa3;
    border: 1px solid #4a6d8c;
    color: #ffffff;
}

QPushButton#secondaryButton:hover {
    background-color: #6b92b8;
    border-color: #5b7fa3;
}

QPushButton#secondaryButton:pressed {
    background-color: #4a6278;
    border-color: #3d5a73;
}

QWidget#playerWidget QPushButton {
    min-height: 34px;
    padding: 6px 10px;
}

QLabel#mutedLabel {
    color: #4a6278;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #c8dced;
}

QListWidget::item:selected {
    background-color: #6ec5e8;
    color: #152238;
}

QListWidget::item:hover {
    background-color: #d6eaf8;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #c8dced;
    border: 1px solid #b8d4ea;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -4px 0;
    background: #4a9fd4;
    border: 1px solid #3d8cc4;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #5bb3e8;
}

QSplitter::handle {
    background-color: #7eb8dc;
    border: 1px solid #b8d4ea;
    border-radius: 2px;
}

QSplitter::handle:horizontal {
    width: 10px;
    margin: 2px 1px;
}

QSplitter::handle:vertical {
    height: 10px;
    margin: 1px 2px;
}

QSplitter::handle:hover {
    background-color: #4a9fd4;
    border-color: #3d8cc4;
}

QSplitter::handle:pressed {
    background-color: #2d6fa8;
}

QTabWidget::pane {
    background-color: #f5faff;
    border: 1px solid #b8d4ea;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #dceaf5;
    border: 1px solid #b8d4ea;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 14px;
    margin-right: 2px;
    color: #4a6278;
}

QTabBar::tab:selected {
    background-color: #4a9fd4;
    color: #ffffff;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #c8dced;
    color: #152238;
}

QCheckBox {
    spacing: 6px;
    color: #152238;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b8d4ea;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #4a9fd4;
    border-color: #3d8cc4;
}

QCheckBox::indicator:hover {
    border-color: #4a9fd4;
}

QLabel#hdmiTitle {
    font-size: 48px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#hdmiSinger {
    font-size: 36px;
    color: #6ec5e8;
}

QLabel#hdmiNext {
    font-size: 24px;
    color: #8fa8c4;
}

.badge-local {
    color: #2e7d52;
}

.badge-youtube {
    color: #c62828;
}

.badge-downloading {
    color: #e65100;
}

QPushButton:disabled {
    background-color: #dceaf5;
    border-color: #c8dced;
    color: #8fa8c4;
}

QPushButton#modeToggle,
QPushButton#themeToggle {
    background-color: #dceaf5;
    border: 1px solid #b8d4ea;
    padding: 6px 14px;
    font-weight: 600;
    color: #4a6278;
}

QPushButton#modeToggle:hover,
QPushButton#themeToggle:hover {
    background-color: #c8dced;
    border-color: #9ec5e0;
}

QPushButton#modeToggle:pressed,
QPushButton#themeToggle:pressed {
    background-color: #b8d4ea;
}

QPushButton#modeToggleActive,
QPushButton#themeToggleActive {
    background-color: #4a9fd4;
    border: 1px solid #3d8cc4;
    padding: 6px 14px;
    font-weight: 600;
    color: #ffffff;
}

QPushButton#modeToggleActive:hover,
QPushButton#themeToggleActive:hover {
    background-color: #5bb3e8;
    border-color: #4a9fd4;
}

QPushButton#modeToggleActive:pressed,
QPushButton#themeToggleActive:pressed {
    background-color: #2d6fa8;
}

QScrollBar:vertical {
    background: #dceaf5;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #7eb8dc;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4a9fd4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #dceaf5;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #7eb8dc;
    border-radius: 6px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #4a9fd4;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
