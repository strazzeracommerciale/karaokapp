/* KaraokeManager — tema B: blu profondo colorato (celeste → blu) */

* {
    font-family: ".AppleSystemUIFont", "Helvetica Neue", sans-serif;
    color: #e8f0fa;
}

QMainWindow, QWidget {
    background-color: #2b4a6e;
}

QLineEdit, QListWidget, QComboBox {
    background-color: #325a80;
    border: 1px solid #4a7ba7;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e8f0fa;
    selection-background-color: #4a9fd4;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #6ec5e8;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #234568;
    border: 1px solid #4a7ba7;
    selection-background-color: #4a9fd4;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #4a9fd4;
    border: 1px solid #5bb3e8;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    color: #ffffff;
}

QPushButton:hover {
    background-color: #5bb3e8;
    border-color: #6ec5e8;
}

QPushButton:pressed {
    background-color: #2d6fa8;
    border-color: #4a9fd4;
}

QPushButton#secondaryButton {
    background-color: #3d5a73;
    border: 1px solid #4a6d8c;
    color: #e8f0fa;
}

QPushButton#secondaryButton:hover {
    background-color: #4a6d8c;
    border-color: #5b7fa3;
}

QPushButton#secondaryButton:pressed {
    background-color: #2e4558;
    border-color: #3d5a73;
}

QWidget#playerWidget QPushButton {
    min-height: 34px;
    padding: 6px 10px;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #3d6b99;
}

QListWidget::item:selected {
    background-color: #3d8cc4;
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #366990;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #3d5a73;
    border: 1px solid #4a6d8c;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -4px 0;
    background: #6ec5e8;
    border: 1px solid #5bb3e8;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #8ed4f0;
}

QSplitter::handle {
    background-color: #4a6d8c;
    border: 1px solid #5b7fa3;
    border-radius: 2px;
}

QSplitter::handle:horizontal {
    width: 10px;
    margin: 2px 1px;
}

QSplitter::handle:vertical {
    height: 10px;
    margin: 1px 2px;
}

QSplitter::handle:hover {
    background-color: #6ec5e8;
    border-color: #8ed4f0;
}

QSplitter::handle:pressed {
    background-color: #4a9fd4;
    border-color: #5bb3e8;
}

QTabWidget::pane {
    background-color: #234568;
    border: 1px solid #4a7ba7;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #2b4a6e;
    border: 1px solid #4a7ba7;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 14px;
    margin-right: 2px;
    color: #b8cfe0;
}

QTabBar::tab:selected {
    background-color: #4a9fd4;
    color: #ffffff;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #3d6b99;
    color: #e8f0fa;
}

QCheckBox {
    spacing: 6px;
    color: #e8f0fa;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4a7ba7;
    border-radius: 4px;
    background-color: #325a80;
}

QCheckBox::indicator:checked {
    background-color: #4a9fd4;
    border-color: #6ec5e8;
}

QCheckBox::indicator:hover {
    border-color: #6ec5e8;
}

QLabel#hdmiTitle {
    font-size: 48px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#hdmiSinger {
    font-size: 36px;
    color: #6ec5e8;
}

QLabel#hdmiNext {
    font-size: 24px;
    color: #8fa8c4;
}

.badge-local {
    color: #7dcea0;
}

.badge-youtube {
    color: #ff7b7b;
}

.badge-downloading {
    color: #ffc56a;
}

QPushButton:disabled {
    background-color: #2a4058;
    border-color: #3d5a73;
    color: #6a7a8c;
}

QPushButton#modeToggle {
    background-color: #3d5a73;
    border: 1px solid #4a6d8c;
    padding: 6px 14px;
    font-weight: 600;
    color: #c8dced;
}

QPushButton#modeToggle:hover {
    background-color: #4a6d8c;
    border-color: #5b7fa3;
}

QPushButton#modeToggle:pressed {
    background-color: #2e4558;
}

QPushButton#modeToggleActive {
    background-color: #4a9fd4;
    border: 1px solid #6ec5e8;
    padding: 6px 14px;
    font-weight: 600;
    color: #ffffff;
}

QPushButton#modeToggleActive:hover {
    background-color: #5bb3e8;
    border-color: #8ed4f0;
}

QPushButton#modeToggleActive:pressed {
    background-color: #2d6fa8;
}

QPushButton#themeToggle {
    background-color: #3d5a73;
    border: 1px solid #4a6d8c;
    padding: 6px 14px;
    font-weight: 600;
    color: #c8dced;
}

QPushButton#themeToggle:hover {
    background-color: #4a6d8c;
    border-color: #5b7fa3;
}

QPushButton#themeToggle:pressed {
    background-color: #2e4558;
}

QPushButton#themeToggleActive {
    background-color: #4a9fd4;
    border: 1px solid #6ec5e8;
    padding: 6px 14px;
    font-weight: 600;
    color: #ffffff;
}

QPushButton#themeToggleActive:hover {
    background-color: #5bb3e8;
    border-color: #8ed4f0;
}

QPushButton#themeToggleActive:pressed {
    background-color: #2d6fa8;
}

QLabel#mutedLabel {
    color: #8fa8c4;
}

QScrollBar:vertical {
    background: #234568;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #4a6d8c;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #6ec5e8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #234568;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #4a6d8c;
    border-radius: 6px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #6ec5e8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
